<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="nw.shared.files" Version="1.0.0" />
    <PackageReference Include="nw.shared.serialization" Version="1.0.0" />
    <PackageReference Include="nw.shared.validation" Version="1.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SYSLIB0014;1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../scripts/nwbuilders/numbworks_logo_256x256px.png" Pack="true" PackagePath="\" />
    <None Include="../../scripts/nwbuilders/NW.UnivariateForecasting.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <Version>4.2.1</Version>
    <AssemblyVersion>4.2.1.0</AssemblyVersion>
    <FileVersion>4.2.1.0</FileVersion>
    <Authors>numbworks</Authors>
    <Copyright>numbworks 2026</Copyright>
    <Description>NW.UnivariateForecasting is a library to perform Univariate Forecasting on your own values. Time Series Forecasting is a machine learning technique that aims to predict the next values in a time series when a subset of subsequent values is provided.</Description>
    <IsPackable>true</IsPackable>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>numbworks_logo_256x256px.png</PackageIcon>
    <PackageReadmeFile>NW.UnivariateForecasting.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageProjectUrl>https://github.com/numbworks/NW.UnivariateForecasting</PackageProjectUrl>
    <RepositoryUrl>https://github.com/numbworks/NW.UnivariateForecasting</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>library csharp machine learning univariate forecasting</PackageTags>
  </PropertyGroup>

</Project>